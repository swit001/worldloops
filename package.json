{
  "name": "worldloops",
  "version": "0.3.1",
  "description": "Executable world layer for OpenClaw that detects open loops, proposes governed transitions, and keeps agent execution safe with externalWrite:false.",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "brief:reconcile": "node dist/scripts/briefReconcile.js",
    "brief:daily": "node dist/scripts/briefDaily.js",
    "discovery:run": "node dist/scripts/discoveryRun.js",
    "notifications:init": "node dist/scripts/notificationsInit.js",
    "notifications:show": "node dist/scripts/notificationsShow.js",
    "notifications:set": "node dist/scripts/notificationsSet.js",
    "smoke": "npm run build && npm run test:thread-hints && npm run test:notifications && npm run test:receipts && npm run test:open-loops && npm run test:capabilities && npm run test:severity-policy && npm run test:stuck-loops",
    "smoke:public": "node scripts/smoke-reconcile.mjs",
    "smoke:reconcile": "node scripts/smoke-reconcile.mjs",
    "test:thread-hints": "node tests/threadHints.test.cjs",
    "test:notifications": "node tests/notifications.test.cjs",
    "test:receipts": "node tests/transitionReceipts.test.cjs",
    "receipt:list": "node dist/scripts/receiptList.js",
    "loop:list": "node dist/scripts/loopList.js",
    "loop:transition": "node dist/scripts/loopTransition.js",
    "test:open-loops": "node tests/openLoopStates.test.cjs",
    "capability:show": "node dist/scripts/capabilityShow.js",
    "test:capabilities": "node tests/capabilityBoundary.test.cjs",
    "test:severity-policy": "node tests/severityPolicy.test.cjs",
    "loop:reconcile": "node dist/scripts/loopReconcile.js",
    "test:stuck-loops": "node tests/stuckLoopPolicy.test.cjs"
  },
  "keywords": [
    "openclaw",
    "clawhub",
    "worldloops",
    "agent",
    "agentic-ai",
    "world-model",
    "executable-world",
    "open-loops",
    "open-loop-management",
    "workflow",
    "human-in-the-loop",
    "safe-by-default",
    "externalWrite-false",
    "auditable-runtime",
    "stateful-loop-management"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
